# Copy to .streamlit/secrets.toml and fill in. NEVER commit secrets.toml.
APP_PASSWORD = "change-me"

# Optional - without it the app still does all official-source lookups, just no AI step.
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-5-nano"

# Optional - free key from https://nvd.nist.gov/developers/request-an-api-key (faster: 50 req / 30 s)
NVD_API_KEY = ""

# Optional - raises the GitHub API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN = ""
