# Copy to .streamlit/secrets.toml and fill in. NEVER commit secrets.toml.

# Optional - without it the app still does all official-source lookups, just no AI step.
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-5-nano"

# Optional - free key from https://nvd.nist.gov/developers/request-an-api-key (faster: 50 req / 30 s)
NVD_API_KEY = ""

# Optional - raises the GitHub API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN = ""

# Login accounts. role = "user" (submit requests, Ask IT) or "admin" (also approve requests, edit policies).
# Add more [users.<name>] blocks for more accounts. Use long, unique passwords.
[users.user]
password = "change-me-user"
role = "user"

[users.admin]
password = "change-me-admin"
role = "admin"
